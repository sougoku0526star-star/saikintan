# 環境変数のサンプル。実値は .env.local（gitignore済み）や本番のホスティング設定に置く。
# コードにシークレットを直書きしないこと。

# Mapbox の公開トークン（NEXT_PUBLIC_ 接頭辞でクライアントに露出）
NEXT_PUBLIC_MAPBOX_TOKEN=
# 任意：地図スタイルを差し替える場合のみ
NEXT_PUBLIC_MAPBOX_STYLE=

# サーバー専用（クライアントに露出しない）
ANTHROPIC_API_KEY=
EXCHANGERATE_API_KEY=

# DB接続（Turso / libSQL）。
# この2つが両方セットされていれば Turso に接続し、無ければローカルの
# file:.data/saikintan.db（SQLite）にフォールバックする（開発はこれで完結・設定不要）。
# 本番(Vercel)では両方を環境変数に登録すること。取得手順は README.md を参照。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 使用モデル（未設定なら既定のSonnetを使用。原価を抑えたい/上げたい時だけ指定）
# LETTER_MODEL: 週次レター・一食コメントの文章生成用
LETTER_MODEL=
# ANALYZE_MODEL: 写真解析（ビジョン）用。判定精度が要る場合は claude-opus-4-8 に上げる
ANALYZE_MODEL=
